# Production Environment Variables
# Copy this to .env and update with your actual values

# Database
MONGODB_URL=mongodb://admin:password123@mongodb:27017/camel_rating?authSource=admin

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-use-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:80,https://yourdomain.com

# Logging
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=models/camel_model.h5
MODEL_CONFIDENCE_THRESHOLD=0.5
